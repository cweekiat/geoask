# Copy to .env (never committed) and fill in.
# Locate (photo geolocation) uses the Claude API: https://console.anthropic.com
ANTHROPIC_API_KEY=
# sonnet (default, Claude Sonnet 5.5) or haiku (Claude Haiku 5.5, much cheaper)
GEOASK_LOCATE_MODEL=sonnet
# Optional: free Mapillary token adds worldwide street-level reference photos
MAPILLARY_TOKEN=
